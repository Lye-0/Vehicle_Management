{
	"name": "api",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:production": "wrangler deploy --env production",
		"dev": "pnpm run db:migrate:local && wrangler dev --env development",
		"start": "pnpm run db:migrate:local && wrangler dev --env development",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --env development",
		"db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
		"db:seed:development": "node ../../tools/seed-development.mjs",
		"db:seed:local": "pnpm run db:seed:development"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12",
		"wrangler": "^4.152.0",
		"@cloudflare/vitest-plugin": "^1.4.7"
	},
	"dependencies": {
		"@vehicle-management/database": "workspace:*",
		"@vehicle-management/shared": "workspace:*",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.2.13"
	}
}
