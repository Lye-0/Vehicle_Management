		"vitest": "~3.2.0",
		"wrangler": "^4.113.0"
	},
	"dependencies": {
		"@vehicle-management/database": "workspace:*",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.4"
	}
}
