                                        </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border x:Name="LegacyGraphCustomerUngroupDropZone" Grid.Column="1" Margin="8,0,0,0" Padding="8"
                                                VerticalAlignment="Stretch"
                                                Background="#FFF7ED" BorderBrush="#D97706" BorderThickness="1"
                                                CornerRadius="5" AllowDrop="True" Visibility="Collapsed" Opacity="0.62"
                                                DragOver="LegacyGraphCustomerUngroupDropZone_DragOver"
                                                DragLeave="LegacyGraphCustomerUngroupDropZone_DragLeave"
                                                Drop="LegacyGraphCustomerUngroupDropZone_Drop">
                                            <TextBlock Foreground="#9A3412" FontSize="11" TextWrapping="Wrap"
                                                       Text="統合解除\nここへ顧客をドロップ" />
                                        </Border>
                                    </Grid>
                                    <Button Grid.Row="4" x:Name="LegacyGraphReturnToCurrentSelectionButton" Margin="0,8,0,0"
                                            Content="現在の選択に戻る" Click="LegacyGraphReturnToCurrentSelectionButton_Click" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Padding="8" Background="#F7F9FC" BorderBrush="#D8E1EC"
                                    BorderThickness="1" CornerRadius="6">
                                <ScrollViewer x:Name="LegacyGraphScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False"
                                              Background="Transparent"
                                              PreviewMouseLeftButtonDown="LegacyGraphScrollViewer_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="LegacyGraphScrollViewer_PreviewMouseMove"
                                              PreviewMouseLeftButtonUp="LegacyGraphScrollViewer_PreviewMouseLeftButtonUp">
                                        <Grid x:Name="LegacyGraphBoardGrid" Width="1120" Height="720" Background="#F7F9FC">
                                            <Canvas x:Name="LegacyGraphEdgesCanvas" Width="1120" Height="720"
                                                IsHitTestVisible="False" />
                                            <Canvas x:Name="LegacyGraphCanvas" Width="1120" Height="720"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="LegacyGraphCanvas_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="LegacyGraphCanvas_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="LegacyGraphCanvas_PreviewMouseLeftButtonUp"
                                                DragOver="LegacyGraphCanvas_DragOver"
                                                DragLeave="LegacyGraphCanvas_DragLeave"
                                                Drop="LegacyGraphCanvas_Drop" />
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Column="4" Padding="14" Background="#FFFFFF" BorderBrush="#D8E1EC"
                                    BorderThickness="1" CornerRadius="6">
                                <ScrollViewer x:Name="LegacyGraphInspectorScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False"
                                              Background="Transparent"
                                              PreviewMouseLeftButtonDown="LegacyGraphInspectorScrollViewer_PreviewMouseLeftButtonDown"
                                              PreviewMouseMove="LegacyGraphInspectorScrollViewer_PreviewMouseMove"
                                              PreviewMouseLeftButtonUp="LegacyGraphInspectorScrollViewer_PreviewMouseLeftButtonUp">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#10233F"
                                                   Text="選択項目の詳細" />
                                        <TextBlock x:Name="LegacyGraphInspectorTitleText" Margin="0,12,0,0"
                                                   FontSize="17" FontWeight="SemiBold" Foreground="#10233F"
                                                   Text="顧客を選択してください" TextWrapping="Wrap" />
                                        <Border x:Name="LegacyGraphInspectorStateBorder" Margin="0,8,0,0"
                                                Padding="8" Background="#F4F7FB" CornerRadius="5">
                                            <TextBlock x:Name="LegacyGraphInspectorStateText" Foreground="#52647A"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock x:Name="LegacyGraphInspectorStatusText" Margin="0,6,0,0"
                                                   Foreground="#52647A" TextWrapping="Wrap" />
                                        <TextBlock x:Name="LegacyGraphCustomerMergeStatusText" Margin="0,14,0,0"
                                                   Foreground="#805B10" FontSize="12" TextWrapping="Wrap" />
                                        <Button x:Name="LegacyGraphMergeButton" Margin="0,16,0,0"
                                                Style="{StaticResource LegacyGraphPreviewButton}"
                                                Content="顧客情報をプレビュー" IsEnabled="False"
                                                Click="LegacyGraphMergeButton_Click" />
                                        <Button x:Name="LegacyGraphApplyMergePreviewButton" Margin="0,8,0,0"
                                                Style="{StaticResource LegacyGraphApproveButton}"
                                                Content="キャンバスを承認" IsEnabled="False"
                                                Click="LegacyGraphApplyMergePreviewButton_Click" />
                                        <Button x:Name="LegacyGraphRemoveCustomerFromMergeButton" Margin="0,8,0,0"
                                                Content="選択顧客を統合候補から外す" IsEnabled="False"
                                                Visibility="Collapsed" Click="LegacyGraphRemoveCustomerFromMergeButton_Click" />
                                        <Button x:Name="LegacyGraphDissolveCustomerMergeButton" Margin="0,8,0,0"
                                                Content="統合候補を解消" IsEnabled="False"
                                                Visibility="Collapsed" Click="LegacyGraphDissolveCustomerMergeButton_Click" />
                                        <Button x:Name="LegacyGraphReassignButton" Content="仮紐付けを解除"
                                                IsEnabled="False" Visibility="Collapsed" Click="LegacyGraphClearManualLinkButton_Click" />
                                        <TabControl x:Name="LegacyGraphInspectorTabs" Margin="0,14,0,0">
                                            <TabItem Header="統合後">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock FontWeight="SemiBold" Foreground="#10233F" Text="現在の表示内容" />
                                                    <Border Margin="0,8,0,0" Padding="10" Background="#F4F7FB" CornerRadius="5">
                                                        <TextBlock x:Name="LegacyGraphInspectorDetailsText" Foreground="#36465A"
                                                                   TextWrapping="Wrap" LineHeight="21" />
                                                    </Border>
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="統合元">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="LegacyGraphInspectorSourcesPlaceholderText" Foreground="#52647A"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl x:Name="LegacyGraphInspectorSourcesItemsControl" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,8" Padding="8" Background="{Binding BackgroundBrush}"
                                                                        BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="5">
                                                                    <StackPanel>
                                                                        <TextBlock FontWeight="SemiBold" Foreground="#10233F"
                                                                                   Text="{Binding Title}" TextWrapping="Wrap" />
                                                                        <TextBlock Margin="0,3,0,0" Foreground="#52647A"
                                                                                   Text="{Binding Details}" TextWrapping="Wrap" />
                                                                        <TextBlock Margin="0,3,0,0" Foreground="#718096" FontSize="11"
                                                                                   Text="{Binding SourceLabel}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="差分・根拠">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock x:Name="LegacyGraphInspectorDifferencesPlaceholderText" Foreground="#52647A"
                                                               TextWrapping="Wrap" />
                                                    <ItemsControl x:Name="LegacyGraphInspectorDifferencesItemsControl" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,8" Padding="8" Background="{Binding BackgroundBrush}"
                                                                        BorderBrush="{Binding BorderBrush}" BorderThickness="1" CornerRadius="5">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="72" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Foreground="#36465A"
                                                                                   Text="{Binding FieldLabel}" TextWrapping="Wrap" />
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Foreground="#52647A" Text="{Binding CandidateValues}"
                                                                                       TextWrapping="Wrap" />
                                                                            <TextBlock Margin="0,3,0,0" Foreground="#10233F"
                                                                                       FontWeight="SemiBold" Text="{Binding ResultText}" TextWrapping="Wrap" />
                                                                            <TextBlock Margin="0,3,0,0" Foreground="{Binding StatusBrush}"
                                                                                       FontSize="11" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#10233F" Text="判定の根拠" />
                                                    <TextBlock x:Name="LegacyGraphInspectorEvidenceText" Margin="0,4,0,0"
                                                               Foreground="#52647A" TextWrapping="Wrap" LineHeight="20" />
                                                </StackPanel>
                                            </TabItem>
                                        </TabControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <TextBlock Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="未確定トレイ" />
                        <TextBlock Margin="0,5,0,8" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="車両・販売書類・整備書類を分けて表示します。中央の書類ブロックをトレイへドラッグすると、元の自動紐付けも一時的に未確定へ戻せます。トレイに残した書類は、画面下部のインポート確定時に件数と内訳を確認し、その時点で今回のインポートから除外します。" />
                        <Grid Height="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="10" Background="#F8FAFC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="#10233F" Text="未確定車両" />
                                    <ListBox x:Name="LegacyGraphUnresolvedVehicleList" Margin="0,7,0,0" Height="195"
                                             SelectionChanged="LegacyGraphUnresolvedSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,3" Padding="8" Background="#FEF2F2" BorderBrush="#B91C1C"
                                                        BorderThickness="2" CornerRadius="5">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding VehicleName}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="#A61B1B" FontSize="11"
                                                                   Text="{Binding Warning}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="#718096" FontSize="11"
                                                                   Text="{Binding SourceFileName}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="10" Background="#F8FAFC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="#10233F" Text="未確定販売書類" />
                                    <ListBox x:Name="LegacyGraphUnresolvedSalesList" Margin="0,7,0,0" Height="195" AllowDrop="True"
                                             SelectionChanged="LegacyGraphUnresolvedSelectionChanged"
                                             PreviewMouseLeftButtonDown="LegacyGraphUnresolvedDocumentList_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="LegacyGraphUnresolvedDocumentList_PreviewMouseMove"
                                             PreviewMouseLeftButtonUp="LegacyGraphUnresolvedDocumentList_PreviewMouseLeftButtonUp"
                                             DragOver="LegacyGraphUnresolvedDocumentList_DragOver"
                                             DragLeave="LegacyGraphUnresolvedDocumentList_DragLeave"
                                             Drop="LegacyGraphUnresolvedDocumentList_Drop">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,3" Padding="8" Background="#FFF7ED" BorderBrush="#D97706"
                                                        BorderThickness="2" CornerRadius="5" Cursor="SizeAll">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DocumentNumber, StringFormat=販売書類 {0}}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="#52647A" FontSize="11"
                                                                   TextWrapping="Wrap">
                                                            <Run Text="{Binding CustomerName}" />
                                                            <Run Text=" / " />
                                                            <Run Text="{Binding VehicleName}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,3,0,0" Foreground="#D97706" FontSize="11"
                                                                   TextWrapping="Wrap">
                                                            <Run Text="{Binding MatchStatus}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Warning}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,4,0,0" Foreground="#8A5A00" FontSize="10"
                                                                   Text="車両ブロックへドラッグして仮紐付け" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Padding="10" Background="#F8FAFC" BorderBrush="#D8E1EC" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="#10233F" Text="未確定整備書類" />
                                    <ListBox x:Name="LegacyGraphUnresolvedMaintenanceList" Margin="0,7,0,0" Height="195" AllowDrop="True"
                                             SelectionChanged="LegacyGraphUnresolvedSelectionChanged"
                                             PreviewMouseLeftButtonDown="LegacyGraphUnresolvedDocumentList_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="LegacyGraphUnresolvedDocumentList_PreviewMouseMove"
                                             PreviewMouseLeftButtonUp="LegacyGraphUnresolvedDocumentList_PreviewMouseLeftButtonUp"
                                             DragOver="LegacyGraphUnresolvedDocumentList_DragOver"
                                             DragLeave="LegacyGraphUnresolvedDocumentList_DragLeave"
                                             Drop="LegacyGraphUnresolvedDocumentList_Drop">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2,3" Padding="8" Background="#FFF7ED" BorderBrush="#D97706"
                                                        BorderThickness="2" CornerRadius="5" Cursor="SizeAll">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding DocumentNumber, StringFormat=整備書類 {0}}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="#52647A" FontSize="11"
                                                                   TextWrapping="Wrap">
                                                            <Run Text="{Binding CustomerName}" />
                                                            <Run Text=" / " />
                                                            <Run Text="{Binding VehicleName}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,3,0,0" Foreground="#D97706" FontSize="11"
                                                                   TextWrapping="Wrap">
                                                            <Run Text="{Binding MatchStatus}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Warning}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,4,0,0" Foreground="#8A5A00" FontSize="10"
                                                                   Text="車両ブロックへドラッグして仮紐付け" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Margin="0,14,0,0" Padding="12" Background="#EAF2FF" BorderBrush="#93C5FD"
                                BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <Button x:Name="LegacyGraphFinalizeImportButton"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource LegacyGraphApproveButton}"
                                        Content="インポート内容を確定"
                                        IsEnabled="False"
                                        Click="LegacyGraphFinalizeImportButton_Click" />
                                <TextBlock x:Name="LegacyGraphFinalizeImportStatusText" Margin="0,8,0,0"
                                           Foreground="#1E40AF" TextWrapping="Wrap"
                                           Text="顧客統合と書類・ノード操作を完了すると、インポート内容を確定できます。" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Padding="12" Background="#F4F7FB" BorderBrush="#D8E1EC"
                                BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <Button x:Name="LegacyGraphCreateFinalPackageButton"
                                        HorizontalAlignment="Left"
                                        Content="確定内容から登録前パッケージを作成"
                                        IsEnabled="False"
                                        Click="LegacyGraphCreateFinalPackageButton_Click" />
                                <Button x:Name="LegacyGraphOpenFinalPackageButton"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        Content="作成したフォルダーを開く"
                                        IsEnabled="False"
                                        Click="LegacyGraphOpenFinalPackageButton_Click" />
                                <TextBlock x:Name="LegacyGraphFinalPackageStatusText" Margin="0,8,0,0"
                                           Foreground="#52647A" TextWrapping="Wrap"
                                           Text="①インポート内容を確定し、②確定内容から登録前パッケージを作成します。作成後にWeb側でフォルダーを選択します。" />
                                <TextBlock x:Name="LegacyGraphFinalPackageNextStepText" Margin="0,6,0,0"
                                           Foreground="#1E40AF" TextWrapping="Wrap"
                                           Text="次の操作: グラフの操作を終えたら「インポート内容を確定」を押してください。" />
                                <Border Margin="0,8,0,0" Padding="10" Background="#FFFFFF" CornerRadius="5">
                                    <TextBlock x:Name="LegacyGraphFinalPackageResultText" Foreground="#36465A"
                                               LineHeight="22" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,26,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="6C. 全車両一覧エクスポート導線の診断" />
                        <TextBlock Margin="0,7,0,12" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="コピー側ABACUSの標準Windowsメニューを読み取り、全車両一覧を出力できる導線があるか確認します。メニューのクリック、データの編集、保存、エクスポートは行いません。" />
                        <Button x:Name="InspectAbacusMenuButton" HorizontalAlignment="Left"
                                Content="ABACUSメニューを診断" IsEnabled="False"
                                Click="InspectAbacusMenuButton_Click" />
                        <Button x:Name="InspectAbacusNativeWindowsButton" Margin="10,0,0,0" HorizontalAlignment="Left"
                                Content="内部ウィンドウを診断" IsEnabled="False"
                                Click="InspectAbacusNativeWindowsButton_Click" />
                        <TextBlock x:Name="AbacusMenuStatusText" Margin="0,10,0,0" Foreground="#52647A"
                                   Text="コピー側ABACUSを起動してから診断してください。" TextWrapping="Wrap" />
                        <DataGrid x:Name="AbacusMenuItemsGrid" Height="260" Margin="0,14,0,0" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" />
                                <DataGridTextColumn Header="階層" Binding="{Binding Depth}" Width="65" />
                                <DataGridTextColumn Header="表示名" Binding="{Binding Text}" Width="3*" />
                                <DataGridTextColumn Header="Command ID" Binding="{Binding CommandId}" Width="110" />
                                <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsEnabled, Mode=OneWay}" Width="65" />
                                <DataGridCheckBoxColumn Header="サブメニュー" Binding="{Binding HasSubmenu, Mode=OneWay}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="AbacusNativeWindowsStatusText" Margin="0,14,0,0" Foreground="#52647A"
                                   Text="内部ウィンドウ診断は未実行です。" TextWrapping="Wrap" />
                        <Button x:Name="InspectAbacusAutomationButton" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Content="FileMaker ActiveXを診断" IsEnabled="False"
                                Click="InspectAbacusAutomationButton_Click" />
                        <TextBlock x:Name="AbacusAutomationStatusText" Margin="0,10,0,0" Foreground="#52647A"
                                   Text="ActiveX診断は未実行です。" TextWrapping="Wrap" />
                        <DataGrid x:Name="AbacusNativeWindowsGrid" Height="260" Margin="0,10,0,0" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" />
                                <DataGridTextColumn Header="階層" Binding="{Binding Depth}" Width="55" />
                                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="2*" />
                                <DataGridTextColumn Header="表示名" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Control ID" Binding="{Binding ControlId}" Width="90" />
                                <DataGridCheckBoxColumn Header="表示" Binding="{Binding IsVisible, Mode=OneWay}" Width="60" />
                                <DataGridCheckBoxColumn Header="有効" Binding="{Binding IsEnabled, Mode=OneWay}" Width="60" />
                                <DataGridTextColumn Header="Style" Binding="{Binding Style}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Margin="0,14,0,0" Padding="14" Background="#EAF2FF" CornerRadius="8">
                            <TextBlock Foreground="#1E40AF" TextWrapping="Wrap"
                                       Text="この診断結果から、標準メニューのコマンドを安全に呼び出せるか、別の画面認識方式が必要かを次の段階で決定します。" />
                        </Border>

                        <TextBlock Margin="0,26,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="6D. BackUp-5.fp5の格納画像候補を診断" />
                        <TextBlock Margin="0,7,0,12" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="ActiveXを利用できないRuntimeでも、保存用原本のBackUp-5.fp5を読み取り専用で調査します。FileMaker Pro 5.0のヘッダーとJPEG開始・終了マーカーを候補として集計しますが、候補が元画像とは限りません。顧客情報の表示、画像の保存、ABACUSの起動・編集・保存は行いません。診断中はABACUSを終了してください。" />
                        <Button x:Name="InspectFp5Button" HorizontalAlignment="Left"
                                Content="BackUp-5.fp5を診断" Click="InspectFp5Button_Click" />
                        <TextBlock x:Name="Fp5InspectionStatusText" Margin="0,10,0,0" Foreground="#52647A"
                                   Text="未診断" TextWrapping="Wrap" />
                        <DataGrid x:Name="Fp5CandidatesGrid" Height="220" Margin="0,14,0,0" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                  SelectionChanged="Fp5CandidatesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" />
                                <DataGridTextColumn Header="位置" Binding="{Binding Offset}" Width="120" />
                                <DataGridTextColumn Header="サイズ" Binding="{Binding Length}" Width="120" />
                                <DataGridTextColumn Header="幅" Binding="{Binding PixelWidth}" Width="75" />
                                <DataGridTextColumn Header="高さ" Binding="{Binding PixelHeight}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button x:Name="ExtractFp5CandidateButton" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Content="選択したJPEG候補を1件検証出力" IsEnabled="False"
                                Click="ExtractFp5CandidateButton_Click" />
                        <TextBlock x:Name="Fp5CandidateExportStatusText" Margin="0,10,0,0" Foreground="#52647A"
                                   Text="候補を選択すると、標準JPEG構造を再検証してから1件だけ出力します。内部ブロックと判定した場合は保存しません。" TextWrapping="Wrap" />
                        <Border Margin="0,14,0,0" Padding="14" Background="#FFF4D6" CornerRadius="8">
                            <TextBlock x:Name="Fp5InspectionResultText" Foreground="#805B10"
                                       TextWrapping="Wrap" LineHeight="24" />
                        </Border>
                        </StackPanel>
                        <Canvas x:Name="LegacyGraphPageDragPreviewCanvas"
                                IsHitTestVisible="False"
                                Panel.ZIndex="1000" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
