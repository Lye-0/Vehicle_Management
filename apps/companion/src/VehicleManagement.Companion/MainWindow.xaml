<Window x:Class="VehicleManagement.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VehicleManagement.Companion"
        Title="Vehicle Management ローカル補助ソフト"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        PreviewMouseMove="MainWindow_PreviewMouseMove">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="108" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#718096" />
            <Setter Property="Margin" Value="0,0,12,7" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="LegacyGraphPreviewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LegacyGraphApproveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                    <Setter Property="Foreground" Value="#60A5FA" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LegacyMatchingSubcategoryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D8E1EC" />
            <Setter Property="Foreground" Value="#52647A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="5,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style x:Key="LegacyMatchingSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="#52647A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="5,5" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="LegacyGraphModeSwitchRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#52647A" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#2563EB" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#1D4ED8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#DBEAFE" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#93C5FD" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#10233F"
                       Text="ローカル補助ソフト" />
            <TextBlock Margin="0,7,0,0" FontSize="14" Foreground="#52647A" TextWrapping="Wrap"
                       Text="Windows上でのみ実行できるABACUS連携処理を、Webアプリから分離して担当します。" />
        </StackPanel>

        <TabControl x:Name="MainTabControl" Grid.Row="2" Background="White" BorderBrush="#D8E1EC"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem x:Name="ConnectionStatusTab" Header="接続状態" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="24">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                           Text="LegacyHost" />
                                <Border x:Name="StatusBadge" DockPanel.Dock="Right" Padding="12,5"
                                        Background="#E9EEF5" CornerRadius="12">
                                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="#52647A"
                                               Text="停止中" />
                                </Border>
                            </DockPanel>

                            <TextBlock Margin="0,16,0,0" Foreground="#52647A" TextWrapping="Wrap"
                                       Text="古いABACUS環境へのアクセスは、この分離プロセス内だけで実行します。" />

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="プロセスID" />
                                <TextBlock x:Name="ProcessIdText" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="アーキテクチャ" />
                                <TextBlock x:Name="ArchitectureText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="未判定" />
                            </Grid>

                            <Border Margin="0,14,0,0" Padding="12" Background="#F4F7FB" CornerRadius="6">
                                <TextBlock x:Name="DetailText" Foreground="#36465A" TextWrapping="Wrap"
                                           Text="LegacyHostは停止しています。" />
                            </Border>

                            <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                                <Button x:Name="StartButton" Content="起動" Click="StartButton_Click" />
                                <Button x:Name="PingButton" Content="接続確認" Click="PingButton_Click" IsEnabled="False" />
                                <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="AbacusInspectionTab" Header="ABACUS検査・起動" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="1. 保存用原本を読み取り検査" />
                        <TextBlock Margin="0,7,0,12" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="この操作はファイルを読み取るだけです。ABACUSの実行ファイルは起動しません。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourcePathTextBox" MinHeight="38" Padding="9,7"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SourcePathTextBox_TextChanged" />
                            <Button x:Name="SelectSourceButton" Grid.Column="1" Margin="10,0,0,0" Content="フォルダー選択"
                                    Click="SelectSourceButton_Click" />
                            <Button x:Name="InspectFolderButton" Grid.Column="2" Margin="10,0,0,0"
                                    Content="読取検査" Click="InspectFolderButton_Click" />
                        </Grid>

                        <ProgressBar x:Name="OperationProgressBar" Margin="0,14,0,0" Height="7"
                                     Minimum="0" Maximum="1" Value="0" />
                        <DockPanel Margin="0,7,0,0">
                            <TextBlock x:Name="OperationStatusText" Foreground="#52647A" Text="未検査" />
                            <Button x:Name="CancelOperationButton" DockPanel.Dock="Right" Padding="10,4"
                                    MinWidth="80" Margin="8,0,0,0" Content="キャンセル"
                                    IsEnabled="False" Click="CancelOperationButton_Click" />
                        </DockPanel>

                        <Border Margin="0,14,0,0" Padding="16" Background="#F4F7FB" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="検査結果" />
                                <TextBlock x:Name="ValidationResultText" Grid.Column="1" Style="{StaticResource ValueText}" Text="未検査" />
                                <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="ファイル" />
                                <TextBlock x:Name="FileCountText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="合計サイズ" />
                                <TextBlock x:Name="TotalSizeText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="ABACUS形式" />
                                <TextBlock x:Name="SourceArchitectureText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="4" Style="{StaticResource LabelText}" Text="フォルダー指紋" />
                                <TextBlock x:Name="FingerprintText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}"
                                           FontFamily="Consolas" FontSize="12" Text="-" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ValidationMessagesText" Margin="0,10,0,0" Foreground="#805B10"
                                   TextWrapping="Wrap" />

                        <Separator Margin="0,24,0,20" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="2. 作業用コピーを作成" />
                        <TextBlock Margin="0,7,0,12" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="コピー先の親フォルダーを選び、新しいABACUS-Workフォルダーを作成します。既存ファイルは上書きしません。" />
                        <Button x:Name="CreateWorkspaceButton" HorizontalAlignment="Left" Content="コピー先を選んで作成"
                                IsEnabled="False" Click="CreateWorkspaceButton_Click" />
                        <TextBlock x:Name="WorkspacePathText" Margin="0,10,0,0" Foreground="#36465A"
                                   TextWrapping="Wrap" Text="作業用コピーはまだありません。" />

                        <Separator Margin="0,24,0,20" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="3. コピー側ABACUSを起動して認識確認" />
                        <TextBlock Margin="0,7,0,12" Foreground="#A61B1B" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="保存用原本は起動しません。上で作成・検証した作業用コピーだけを起動します。" />
                        <WrapPanel>
                            <Button x:Name="LaunchAbacusButton" Content="コピー側を起動" IsEnabled="False"
                                    Click="LaunchAbacusButton_Click" />
                            <Button x:Name="InspectAbacusButton" Content="再認識" IsEnabled="False"
                                    Click="InspectAbacusButton_Click" />
                            <Button x:Name="CloseAbacusButton" Content="ABACUSを閉じる" IsEnabled="False"
                                    Click="CloseAbacusButton_Click" />
                            <Button x:Name="InspectAbacusNavigationButton" Content="画面遷移状態を診断"
                                    IsEnabled="False" Click="InspectAbacusNavigationButton_Click" />
                        </WrapPanel>
                        <Border Margin="0,14,0,0" Padding="16" Background="#F4F7FB" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="UI Automation" />
                                <TextBlock x:Name="AutomationResultText" Grid.Column="1" Style="{StaticResource ValueText}" Text="未確認" />
                                <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="プロセス構成" />
                                <TextBlock x:Name="ProcessArchitectureText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="ウィンドウ名" />
                                <TextBlock x:Name="AbacusWindowTitleText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="認識要素" />
                                <TextBlock x:Name="AutomationElementCountText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                </Grid>
                        </Border>
                        <Border x:Name="AbacusNavigationStatePanel" Margin="0,14,0,0" Padding="12"
                                Background="#E9EEF5" CornerRadius="6">
                            <StackPanel>
                                <TextBlock x:Name="AbacusNavigationStateText" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#52647A" Text="画面遷移状態は未診断です。" />
                                <TextBlock x:Name="AbacusNavigationDetailText" Margin="0,5,0,0"
                                           Foreground="#52647A" TextWrapping="Wrap"
                                           Text="「画面遷移状態を診断」を押すと、ABACUSメニュー・車両一覧・車両詳細・拡大画像のどこにいるかを画面内容から確認できます。" />
                                <TextBlock x:Name="AbacusNavigationObservedText" Margin="0,5,0,0"
                                           Foreground="#52647A" TextWrapping="Wrap"
                                           Text="確認中の子ウィンドウ: -" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DocumentAnalysisTab" Header="書類データ分析" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="販売・整備バックアップの構造分析" />
                        <TextBlock Margin="0,7,0,12" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="BackUp-2.tab（販売102列）とBackUp-3.tab（整備158列）をShift-JISとして厳格に検査します。この操作は読み取り専用です。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AnalysisPathTextBox" MinHeight="38" Padding="9,7"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AnalysisPathTextBox_TextChanged" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Content="フォルダー選択"
                                    Click="SelectAnalysisFolderButton_Click" />
                            <Button x:Name="AnalyzeDataButton" Grid.Column="2" Margin="10,0,0,0"
                                    Content="構造を分析" Click="AnalyzeDataButton_Click" />
                        </Grid>
                        <TextBlock x:Name="AnalysisStatusText" Margin="0,10,0,0" Foreground="#52647A"
                                   Text="未分析" TextWrapping="Wrap" />

                        <Border Margin="0,18,0,0" Padding="18" Background="#EAF7EF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="OverallAnalysisResultText" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#17643A" Text="分析結果はまだありません。" TextWrapping="Wrap" />
                                <TextBlock x:Name="OverallAnalysisDetailText" Margin="0,7,0,0" Foreground="#36465A"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="16" Background="#F4F7FB" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#10233F" Text="販売書類" />
                                    <TextBlock x:Name="SalesAnalysisText" Margin="0,10,0,0" LineHeight="25"
                                               Foreground="#36465A" Text="未分析" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Padding="16" Background="#F4F7FB" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#10233F" Text="整備書類" />
                                    <TextBlock x:Name="MaintenanceAnalysisText" Margin="0,10,0,0" LineHeight="25"
                                               Foreground="#36465A" Text="未分析" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,18,0,0" Padding="14" Background="#FFF4D6" CornerRadius="8">
                            <TextBlock Foreground="#805B10" TextWrapping="Wrap"
                                       Text="車両候補件数は車台番号、登録番号、顧客＋車両情報の順で保守的に集計した分析値です。この段階では顧客名だけによる統合や、実データへの登録は行いません。" />
                        </Border>
                        <TextBlock x:Name="AnalysisErrorsText" Margin="0,12,0,0" Foreground="#A61B1B"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="LinkagePreviewTab" Header="紐付けプレビュー" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="顧客・複数車両・書類の紐付けプレビュー" />
                        <TextBlock Margin="0,7,0,12" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="名前だけでは統合せず、電話・住所・車台番号・安全な登録番号の一致を根拠に候補を作ります。実データへの登録は行いません。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LinkagePathTextBox" MinHeight="38" Padding="9,7"
                                     VerticalContentAlignment="Center" TextChanged="LinkagePathTextBox_TextChanged" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Content="フォルダー選択"
                                    Click="SelectLinkageFolderButton_Click" />
                            <Button x:Name="BuildLinkageButton" Grid.Column="2" Margin="10,0,0,0"
                                    Content="候補を作成" Click="BuildLinkageButton_Click" />
                        </Grid>
                        <TextBlock x:Name="LinkageStatusText" Margin="0,10,0,0" Foreground="#52647A"
                                   Text="未作成" TextWrapping="Wrap" />

                        <Border Margin="0,18,0,0" Padding="18" Background="#EAF7EF" CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="LinkageResultText" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#17643A" Text="プレビューはまだありません。" TextWrapping="Wrap" />
                                <TextBlock x:Name="LinkageSummaryText" Margin="0,8,0,0" LineHeight="25"
                                           Foreground="#36465A" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Padding="14" Background="#FFF4D6" CornerRadius="8">
                            <TextBlock Foreground="#805B10" TextWrapping="Wrap"
                                       Text="競合は自動統合しません。同姓同名の別人、登録番号の再利用、名義変更、過去所有などを確認するために残しています。" />
                        </Border>

                        <TextBlock Margin="0,20,0,7" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="一覧を氏名・識別子で絞り込み" />
                        <TextBox x:Name="LinkageFilterTextBox" MinHeight="36" Padding="9,6"
                                 TextChanged="LinkageFilterTextBox_TextChanged" />

                        <TextBlock Margin="0,22,0,8" FontSize="17" FontWeight="SemiBold" Foreground="#A61B1B"
                                   Text="同姓同名・情報不一致" />
                        <DataGrid x:Name="SameNameConflictsGrid" Height="220" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="顧客名" Binding="{Binding CustomerName}" Width="2*" />
                                <DataGridTextColumn Header="分離候補" Binding="{Binding SeparateCustomerCandidates}" Width="90" />
                                <DataGridTextColumn Header="書類" Binding="{Binding DocumentCount}" Width="75" />
                                <DataGridTextColumn Header="候補ごとの一致情報" Binding="{Binding EvidenceSummary}" Width="3*" />
                                <DataGridTextColumn Header="判定理由" Binding="{Binding Reason}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Margin="0,22,0,4" FontSize="17" FontWeight="SemiBold" Foreground="#1D4ED8"
                                   Text="同一顧客候補に複数車両" />
                        <TextBlock Margin="0,0,0,8" Foreground="#1E40AF" TextWrapping="Wrap"
                                   Text="これはエラーではありません。同じ顧客へ複数の車両を紐付ける予定の正常な候補です。車両内容だけ確認してください。" />
                        <DataGrid x:Name="MultipleVehicleCustomersGrid" Height="220" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="顧客名" Binding="{Binding CustomerName}" Width="2*" />
                                <DataGridTextColumn Header="車両候補" Binding="{Binding VehicleCount}" Width="100" />
                                <DataGridTextColumn Header="関連書類" Binding="{Binding DocumentCount}" Width="100" />
                                <DataGridTextColumn Header="車両内容" Binding="{Binding VehicleSummary}" Width="4*" />
                            </DataGrid.Columns>
