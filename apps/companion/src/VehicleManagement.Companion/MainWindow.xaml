                                 </StackPanel>
                                 <TextBlock x:Name="UnifiedImportStatusText" Margin="0,12,0,0"
                                            Foreground="#52647A" TextWrapping="Wrap"
                                            Text="ABACUSフォルダーを選択してください。" />
                                 <TextBlock x:Name="UnifiedImportSummaryText" Margin="0,6,0,0"
