<Window x:Class="VehicleManagement.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicle Management ローカル補助ソフト"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="112" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#10233F"
                       Text="ローカル補助ソフト" />
            <TextBlock Margin="0,8,0,0" FontSize="14" Foreground="#52647A" TextWrapping="Wrap"
                       Text="ABACUS連携など、Windows上でのみ実行できる処理を安全に担当します。現在は接続基盤の確認段階です。" />
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Padding="24" Background="White" CornerRadius="12"
                    BorderBrush="#D8E1EC" BorderThickness="1">
                <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                               Text="LegacyHost" />
                    <Border x:Name="StatusBadge" DockPanel.Dock="Right" Padding="12,5"
                            Background="#E9EEF5" CornerRadius="12">
                        <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="#52647A"
                                   Text="停止中" />
                    </Border>
                </DockPanel>

                <TextBlock Margin="0,16,0,0" Foreground="#52647A" TextWrapping="Wrap"
                           Text="古いABACUS環境へのアクセスは、この分離プロセス内だけで実行します。" />

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="#718096" Text="プロセスID" />
                    <TextBlock x:Name="ProcessIdText" Grid.Column="1" FontWeight="SemiBold" Text="-" />
                    <TextBlock Grid.Row="1" Foreground="#718096" Text="アーキテクチャ" />
                    <TextBlock x:Name="ArchitectureText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="未判定" />
                </Grid>

                <Border Margin="0,18,0,0" Padding="12" Background="#F4F7FB" CornerRadius="6">
                    <TextBlock x:Name="DetailText" Foreground="#36465A" TextWrapping="Wrap"
                               Text="LegacyHostは停止しています。" />
                </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="StartButton" Content="起動" Click="StartButton_Click" />
            <Button x:Name="PingButton" Content="接続確認" Click="PingButton_Click" IsEnabled="False" />
            <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
