                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Foreground="#7F1D1D" FontSize="10" Text="顧客番号" />
                                                                    <TextBlock Margin="0,2,0,0" Foreground="#7F1D1D" FontSize="11"
                                                                               Text="{Binding CustomerNumber}" TextTrimming="CharacterEllipsis" />
