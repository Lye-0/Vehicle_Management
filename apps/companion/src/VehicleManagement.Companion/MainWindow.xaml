<Window x:Class="VehicleManagement.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicle Management ローカル補助ソフト"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="108" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#718096" />
            <Setter Property="Margin" Value="0,0,12,7" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#10233F"
                       Text="ローカル補助ソフト" />
            <TextBlock Margin="0,7,0,0" FontSize="14" Foreground="#52647A" TextWrapping="Wrap"
                       Text="Windows上でのみ実行できるABACUS連携処理を、Webアプリから分離して担当します。" />
        </StackPanel>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#D8E1EC">
            <TabItem Header="接続状態">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="24">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                           Text="LegacyHost" />
                                <Border x:Name="StatusBadge" DockPanel.Dock="Right" Padding="12,5"
                                        Background="#E9EEF5" CornerRadius="12">
                                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="#52647A"
                                               Text="停止中" />
                                </Border>
                            </DockPanel>

                            <TextBlock Margin="0,16,0,0" Foreground="#52647A" TextWrapping="Wrap"
                                       Text="古いABACUS環境へのアクセスは、この分離プロセス内だけで実行します。" />

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="プロセスID" />
                                <TextBlock x:Name="ProcessIdText" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="アーキテクチャ" />
                                <TextBlock x:Name="ArchitectureText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="未判定" />
                            </Grid>

                            <Border Margin="0,14,0,0" Padding="12" Background="#F4F7FB" CornerRadius="6">
                                <TextBlock x:Name="DetailText" Foreground="#36465A" TextWrapping="Wrap"
                                           Text="LegacyHostは停止しています。" />
                            </Border>

                            <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                                <Button x:Name="StartButton" Content="起動" Click="StartButton_Click" />
                                <Button x:Name="PingButton" Content="接続確認" Click="PingButton_Click" IsEnabled="False" />
                                <Button x:Name="StopButton" Content="停止" Click="StopButton_Click" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ABACUS検査・起動">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="1. 保存用原本を読み取り検査" />
                        <TextBlock Margin="0,7,0,12" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="この操作はファイルを読み取るだけです。ABACUSの実行ファイルは起動しません。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourcePathTextBox" MinHeight="38" Padding="9,7"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SourcePathTextBox_TextChanged" />
                            <Button x:Name="SelectSourceButton" Grid.Column="1" Margin="10,0,0,0" Content="フォルダー選択"
                                    Click="SelectSourceButton_Click" />
                            <Button x:Name="InspectFolderButton" Grid.Column="2" Margin="10,0,0,0"
                                    Content="読取検査" Click="InspectFolderButton_Click" />
                        </Grid>

                        <ProgressBar x:Name="OperationProgressBar" Margin="0,14,0,0" Height="7"
                                     Minimum="0" Maximum="1" Value="0" />
                        <DockPanel Margin="0,7,0,0">
                            <TextBlock x:Name="OperationStatusText" Foreground="#52647A" Text="未検査" />
                            <Button x:Name="CancelOperationButton" DockPanel.Dock="Right" Padding="10,4"
                                    MinWidth="80" Margin="8,0,0,0" Content="キャンセル"
                                    IsEnabled="False" Click="CancelOperationButton_Click" />
                        </DockPanel>

                        <Border Margin="0,14,0,0" Padding="16" Background="#F4F7FB" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="検査結果" />
                                <TextBlock x:Name="ValidationResultText" Grid.Column="1" Style="{StaticResource ValueText}" Text="未検査" />
                                <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="ファイル" />
                                <TextBlock x:Name="FileCountText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="合計サイズ" />
                                <TextBlock x:Name="TotalSizeText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="ABACUS形式" />
                                <TextBlock x:Name="SourceArchitectureText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="4" Style="{StaticResource LabelText}" Text="フォルダー指紋" />
                                <TextBlock x:Name="FingerprintText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}"
                                           FontFamily="Consolas" FontSize="12" Text="-" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ValidationMessagesText" Margin="0,10,0,0" Foreground="#805B10"
                                   TextWrapping="Wrap" />

                        <Separator Margin="0,24,0,20" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="2. 作業用コピーを作成" />
                        <TextBlock Margin="0,7,0,12" Foreground="#52647A" TextWrapping="Wrap"
                                   Text="コピー先の親フォルダーを選び、新しいABACUS-Workフォルダーを作成します。既存ファイルは上書きしません。" />
                        <Button x:Name="CreateWorkspaceButton" HorizontalAlignment="Left" Content="コピー先を選んで作成"
                                IsEnabled="False" Click="CreateWorkspaceButton_Click" />
                        <TextBlock x:Name="WorkspacePathText" Margin="0,10,0,0" Foreground="#36465A"
                                   TextWrapping="Wrap" Text="作業用コピーはまだありません。" />

                        <Separator Margin="0,24,0,20" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#10233F"
                                   Text="3. コピー側ABACUSを起動して認識確認" />
                        <TextBlock Margin="0,7,0,12" Foreground="#A61B1B" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="保存用原本は起動しません。上で作成・検証した作業用コピーだけを起動します。" />
                        <WrapPanel>
                            <Button x:Name="LaunchAbacusButton" Content="コピー側を起動" IsEnabled="False"
                                    Click="LaunchAbacusButton_Click" />
                            <Button x:Name="InspectAbacusButton" Content="再認識" IsEnabled="False"
                                    Click="InspectAbacusButton_Click" />
                            <Button x:Name="CloseAbacusButton" Content="ABACUSを閉じる" IsEnabled="False"
                                    Click="CloseAbacusButton_Click" />
                        </WrapPanel>
                        <Border Margin="0,14,0,0" Padding="16" Background="#F4F7FB" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource LabelText}" Text="UI Automation" />
                                <TextBlock x:Name="AutomationResultText" Grid.Column="1" Style="{StaticResource ValueText}" Text="未確認" />
                                <TextBlock Grid.Row="1" Style="{StaticResource LabelText}" Text="プロセス構成" />
                                <TextBlock x:Name="ProcessArchitectureText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="2" Style="{StaticResource LabelText}" Text="ウィンドウ名" />
                                <TextBlock x:Name="AbacusWindowTitleText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                                <TextBlock Grid.Row="3" Style="{StaticResource LabelText}" Text="認識要素" />
                                <TextBlock x:Name="AutomationElementCountText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="-" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
