                                             MinHeight="38" Padding="9,7" VerticalContentAlignment="Center"
                                             TextChanged="UnifiedImportOutputParentPathTextBox_TextChanged" />
                                    <Button x:Name="UnifiedImportSelectOutputParentButton" Grid.Column="2"
                                            Margin="10,0,0,0" Content="保存先を選択"
                                            Click="UnifiedImportSelectOutputParentButton_Click" />
                                </Grid>
                                 <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
